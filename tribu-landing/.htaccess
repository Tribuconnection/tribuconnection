# ===================== Tribu Connection — seguridad ===================== #

# Forzar HTTPS
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Perfiles públicos: /slug-de-la-persona -> /perfil-publico/index.html
# (solo si no existe un archivo o carpeta real con ese nombre)
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([a-z0-9][a-z0-9-]*)/?$ /perfil-publico/index.html [L]
</IfModule>

# Cabeceras de seguridad
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://cdnjs.cloudflare.com https://www.instagram.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.arcgisonline.com https://unpkg.com https://*.cdninstagram.com https://*.fbcdn.net https://*.supabase.co; connect-src 'self' https://nominatim.openstreetmap.org https://formsubmit.co https://*.arcgisonline.com https://script.google.com https://script.googleusercontent.com https://www.instagram.com https://*.supabase.co; frame-src 'self' https://www.instagram.com; object-src 'none'; base-uri 'self'; form-action 'self' https://formsubmit.co; frame-ancestors 'self'"
</IfModule>

# Cache: el HTML se revalida siempre (si no, el navegador se queda con una copia
# vieja y los cambios no se ven). Los assets van versionados con ?v=N en la URL,
# asi que pueden cachearse fuerte sin riesgo.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|png|jpg|jpeg|webp|woff2|mp4)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>

# Evitar listado de directorios
Options -Indexes

# No exponer este mismo archivo
<Files ".htaccess">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>
